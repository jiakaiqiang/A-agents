# 将本文件复制为 .mewcode/config.yaml，并把 api_key 改为真实值。
providers:
  - name: Anthropic
    protocol: anthropic
    base_url: https://api.anthropic.com
    model: claude-opus-5
    api_key: <your-key>
    thinking: true

  # OpenAI 兼容端点请使用 openai-compat 协议。
  # - name: OpenAI Compatible
  #   protocol: openai-compat
  #   base_url: https://api.openai.com/v1
  #   model: gpt-4.1-mini
  #   api_key: <your-key>
